{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/session_start.py\"",
            "timeout": 10,
            "additionalContextLimit": 8000,
            "statusMessage": "Confirm Universal Research session permissions"
          }
        ]
      }
    ]
  }
}
