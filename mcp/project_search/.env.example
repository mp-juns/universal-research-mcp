PROJECT_SEARCH_ROOT=/path/to/universal-research-mcp
PROJECT_SEARCH_RESEARCH_DB=/path/to/universal-research-mcp/data/index/research.sqlite
PROJECT_SEARCH_SEMANTIC_DB=/path/to/universal-research-mcp/data/index/semantic.sqlite
PROJECT_SEARCH_SEMANTIC_MANIFEST=/path/to/universal-research-mcp/data/index/semantic-manifest.json

# Generate with:
# python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
PROJECT_SEARCH_API_KEY=CHANGE_ME

PROJECT_SEARCH_DEVICE=cuda
PROJECT_SEARCH_MODEL_IDLE_SECONDS=300
PROJECT_SEARCH_TOP_K_MAX=100
PROJECT_SEARCH_MAX_FETCH_LINES=500
