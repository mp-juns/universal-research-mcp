{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Universal Research Agent Governance Role Manifest v2",
  "type": "object",
  "required": ["schema_version", "agent_id", "display_name", "role_type", "version", "activation", "authority", "evidence"],
  "properties": {
    "schema_version": {"const": "agent-governance/2.0"},
    "agent_id": {"type": "string"},
    "display_name": {"type": "string"},
    "role_type": {"enum": ["operational", "critical"]},
    "version": {"type": "string"},
    "activation": {"type": "object", "required": ["triggers", "modes"]},
    "authority": {"type": "object", "required": ["allowed_actions", "forbidden_actions"]},
    "evidence": {"type": "object", "required": ["requires_source_fetch", "requires_hash_verification", "allows_model_memory_as_evidence"]}
  }
}
